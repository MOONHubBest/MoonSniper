local function askAI()
    if not riddleEnabled then
        aiAnswer.Text = "AI Riddle Scan is OFF. Turn it ON to analyze a question or riddle you paste here."
        return
    end
    local question = aiInput.Text
    if not question or question:match("^%s*$") then
        aiAnswer.Text = "Type a question or paste a riddle first."
        return
    end
    -- To use Sammy-only mode, paste the question with a source label such as "SpyderSammy: ...".
    if sammyOnly and not question:lower():find("spydersammy", 1, true) and not question:lower():find("sammy:", 1, true) then
        aiAnswer.Text = "SAMMY ONLY is ON. Paste the riddle prefixed with 'SpyderSammy: ' so the source is clear."
        return
    end
    local cacheKey = question:lower():gsub("%s+", " "):match("^%s*(.-)%s*$")
    if answerCache[cacheKey] then
        aiAnswer.Text = answerCache[cacheKey]
        return
    end
    if AI_ENDPOINT:find("YOUR%-BACKEND%-URL") then
        aiAnswer.Text = "Setup needed: replace AI_ENDPOINT with your backend URL. Keep your OpenAI API key on the backend, not in this script."
        return
    end
    local httpRequest = getHttpRequest()
    if not httpRequest then
        aiAnswer.Text = "HTTP request is unavailable in this environment. Configure a supported backend connection."
        return
    end

    aiAskButton.Text = "THINKING..."
    aiAskButton.Active = false
    task.spawn(function()
        local ok, result = pcall(function()
            return httpRequest({
                Url = AI_ENDPOINT,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    message = question,
                    task = "solve_riddle",
                    instruction = "Solve the riddle/question. Return ONLY the shortest final answer or redeem-code text. No explanation, no punctuation around it, no extra words."
                })
            })
        end)
        if not ok or type(result) ~= "table" then
            aiAnswer.Text = "Could not reach the AI backend. Check the backend URL and its availability."
        elseif result.StatusCode and (result.StatusCode < 200 or result.StatusCode >= 300) then
            aiAnswer.Text = "AI backend returned HTTP " .. tostring(result.StatusCode) .. ". Check its logs/configuration."
        else
            local decodedOk, decoded = pcall(function()
                return HttpService:JSONDecode(result.Body or "{}")
            end)
            if decodedOk and type(decoded) == "table" then
                aiAnswer.Text = tostring(decoded.answer or decoded.response or decoded.output or "No answer field found. Return JSON with an 'answer' field.")
                answerCache[cacheKey] = aiAnswer.Text
            else
                aiAnswer.Text = "The backend response was not valid JSON. Return {\"answer\":\"...\"}."
            end
        end
        aiAskButton.Text = "ASK AI / SOLVE RIDDLE"
        aiAskButton.Active = true
    end)
end
